{
  "agents": [
    {
      "name": "qa_agent",
      "provider": "github",
      "model": "gpt-4",
      "system_prompt": "You are a helpful assistant that answers questions about knowledge graphs.",
      "temperature": 0.7,
      "max_tokens": 1000,
      "tools": []
    }
  ],
  "default_provider": "github",
  "api_keys": {
    "github": "${GITHUB_TOKEN}"
  },
  "dialog": {
    "enabled": true,
    "auto_reply": true,
    "record_thinking": true
  }
}
